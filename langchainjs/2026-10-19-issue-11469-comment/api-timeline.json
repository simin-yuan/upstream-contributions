        "pull_request": {
          "url": "https://api.github.com/repos/langchain-ai/langchainjs/pulls/11471",
          "html_url": "https://github.com/langchain-ai/langchainjs/pull/11471",
          "diff_url": "https://github.com/langchain-ai/langchainjs/pull/11471.diff",
