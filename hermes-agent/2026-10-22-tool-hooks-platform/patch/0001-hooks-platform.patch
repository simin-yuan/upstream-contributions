diff --git a/tests/agent/test_tool_hook_platform.py b/tests/agent/test_tool_hook_platform.py
new file mode 100644
index 0000000000..8932798a23
--- /dev/null
+++ b/tests/agent/test_tool_hook_platform.py
@@ -0,0 +1,90 @@
+"""Tool-path hooks carry ``platform`` — the same value ``pre_llm_call`` already gets.
+
+Contract under test: a plugin that gates tool calls can tell an attended turn from an
+unattended one (``cron`` / ``subagent`` / ``curator``) without guessing from session ids.
+Covers all three tool hooks (pre/post/transform) plus the shell-hook ``extra`` dict.
+"""
+
+from types import SimpleNamespace
+
+from agent.inline_tool_executors import tool_hook_ids
+from model_tools import _CallIds, _apply_transform_tool_result_hook, _emit_post_tool_call_hook
+
+
+def _agent(platform="cron"):
+    return SimpleNamespace(
+        platform=platform,
+        session_id="sess-1",
+        _current_turn_id="turn-1",
+        _current_api_request_id="api-1",
+    )
+
+
+def test_tool_hook_ids_carries_agent_platform():
+    ids = tool_hook_ids(_agent("cron"), "task-1", "call-1")
+    assert ids["platform"] == "cron"
+    # Unknown platform (older agent object, programmatic caller) coerces to "" like the other ids.
+    assert tool_hook_ids(SimpleNamespace(), "t", "c")["platform"] == ""
+
+
+def test_call_ids_round_trips_platform_into_hook_kwargs():
+    ids = _CallIds(**tool_hook_ids(_agent("subagent"), "task-1", "call-1"))
+    assert ids.hook_kwargs()["platform"] == "subagent"
+
+
+def test_pre_tool_call_hook_receives_platform(monkeypatch):
+    from hermes_cli import lifecycle
+    from hermes_cli.plugins import _dispatch_pre_tool_call_hooks
+
+    seen = {}
+
+    def fake_invoke_hook(hook_name, **kwargs):
+        seen.update(kwargs)
+        return []
+
+    monkeypatch.setattr(lifecycle, "invoke_hook", fake_invoke_hook)
+    _dispatch_pre_tool_call_hooks("terminal", {"command": "echo hi"}, task_id="t", platform="cron")
+    assert seen["platform"] == "cron"
+
+
+def test_post_tool_call_hook_receives_platform(monkeypatch):
+    from hermes_cli import lifecycle
+
+    seen = {}
+
+    def fake_invoke_hook(hook_name, **kwargs):
+        seen.update(kwargs)
+        return []
+
+    monkeypatch.setattr(lifecycle, "has_hook", lambda _name: True)
+    monkeypatch.setattr(lifecycle, "invoke_hook", fake_invoke_hook)
+    _emit_post_tool_call_hook(function_name="terminal", function_args={}, result="ok",
+                              platform="curator")
+    assert seen["platform"] == "curator"
+
+
+def test_transform_tool_result_hook_receives_platform(monkeypatch):
+    from hermes_cli import lifecycle
+
+    seen = {}
+
+    def fake_invoke_hook(hook_name, **kwargs):
+        seen.update(kwargs)
+        return ["rewritten"]
+
+    monkeypatch.setattr(lifecycle, "has_hook", lambda _name: True)
+    monkeypatch.setattr(lifecycle, "invoke_hook", fake_invoke_hook)
+    out = _apply_transform_tool_result_hook(
+        "terminal", {}, "raw", 1, _CallIds(**tool_hook_ids(_agent("cron"), "t", "c")))
+    assert out == "rewritten"
+    assert seen["platform"] == "cron"
+
+
+def test_shell_hook_payload_carries_tool_hook_identity_in_extra():
+    """Shell hooks: identity fields the payload does not promote land in ``extra``."""
+    from agent.shell_hooks import _payload_fields
+
+    payload = _payload_fields({"tool_name": "terminal", "args": {},
+                               **tool_hook_ids(_agent("cron"), "task-1", "call-1")})
+    assert "platform" not in payload
+    assert payload["extra"]["platform"] == "cron"
diff --git a/tests/cron/test_cron_tool_hook_platform.py b/tests/cron/test_cron_tool_hook_platform.py
new file mode 100644
index 0000000000..5fa14b034e
--- /dev/null
+++ b/tests/cron/test_cron_tool_hook_platform.py
@@ -0,0 +1,68 @@
+"""A tool hook fired inside a scheduled job sees ``platform == "cron"`` end to end.
+
+The same field ``pre_llm_call`` already receives; without it a policy plugin cannot tell an
+unattended cron run from an attended turn and has to fail closed on both.
+"""
+import json
+import os
+import subprocess
+import sys
+from datetime import timedelta
+from pathlib import Path
+
+from tests.fakes.fake_llm_provider import FakeLLMServer, Text, ToolCall, write_hermes_home
+
+_PLUGIN = '''
+import json, os
+from pathlib import Path
+
+def _record(**kwargs):
+    out = Path(os.environ["HERMES_HOME"]) / "seen.json"
+    out.write_text(json.dumps({"tool": kwargs.get("tool_name"),
+                               "platform": kwargs.get("platform")}))
+
+def register(ctx):
+    ctx.register_hook("pre_tool_call", _record)
+'''
+
+_TICK = '''
+import json
+from cron import scheduler, scheduler_authority
+from tests.cron.conftest import owner_execution_runner
+scheduler_authority.run_canonical_job = owner_execution_runner()
+scheduler.tick(verbose=False, sync=True)
+print(json.dumps({"ok": True}))
+'''
+
+
+def test_tool_hook_in_a_ticked_job_sees_platform_cron(tmp_path):
+    from hermes_time import now
+
+    home = tmp_path / "home"
+    plugin_dir = home / "plugins" / "cron-platform-probe"
+    plugin_dir.mkdir(parents=True)
+    (plugin_dir / "plugin.yaml").write_text("name: cron-platform-probe\nversion: 0.0.1\n")
+    (plugin_dir / "__init__.py").write_text(_PLUGIN)
+    note = home / "note.txt"
+    with FakeLLMServer([ToolCall("read_file", {"path": str(note)}), Text("done")]) as srv:
+        write_hermes_home(home, srv.base_url,
+                          extra_config="plugins:\n  enabled: [cron-platform-probe]\n")
+        note.write_text("hello\n")
+        (home / "cron").mkdir()
+        (home / "cron" / "jobs.json").write_text(json.dumps({"jobs": [{
+            "id": "platform-probe", "name": "platform probe", "prompt": "read the note",
+            "schedule": {"kind": "interval", "minutes": 240},
+            "next_run_at": (now() - timedelta(minutes=1)).isoformat(),
+            "enabled": True, "state": "scheduled", "deliver": "local",
+            "repeat": {"times": None, "completed": 0}}]}))
+        env = {k: v for k, v in os.environ.items()
+               if not k.startswith(("HERMES_", "_HERMES_"))
+               and not k.endswith(("_API_KEY", "_TOKEN"))}
+        env.update(HERMES_HOME=str(home), PYTHONPATH=str(Path(__file__).resolve().parents[2]))
+        result = subprocess.run([sys.executable, "-c", _TICK], env=env, stdin=subprocess.DEVNULL,
+                                capture_output=True, text=True, timeout=180, check=False)
+    assert result.returncode == 0, result.stdout + result.stderr
+    seen = json.loads((home / "seen.json").read_text())
+
+    assert seen["tool"] == "read_file"
+    assert seen["platform"] == "cron"
